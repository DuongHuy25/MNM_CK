            "date": 1779353093302,
            "name": "Commit-0",
            "content": "{% extends 'eshop/base.html' %}\r\n{% block title %}{{ product.name }} - ZenMart{% endblock %}\r\n{% block content %}\r\n\r\n<div class=\"max-w-7xl mx-auto px-6 py-12 space-y-8\">\r\n\r\n    <!-- Breadcrumb -->\r\n    <nav class=\"text-sm text-gray-500 flex items-center gap-1 mb-6\">\r\n        <a href=\"{% url 'eshop:home' %}\" class=\"text-blue-600 hover:underline\">Trang chủ</a>\r\n        <span>›</span>\r\n        <a href=\"{% url 'eshop:products' %}\" class=\"text-blue-600 hover:underline\">Sản phẩm</a>\r\n        <span>›</span>\r\n        <a href=\"{% url 'eshop:products' %}?category={{ product.category.slug }}\" class=\"text-blue-600 hover:underline\">{{ product.category.name }}</a>\r\n        <span>›</span>\r\n        <span class=\"text-gray-400\">{{ product.name }}</span>\r\n    </nav>\r\n\r\n    <!-- Product Detail Grid -->\r\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\r\n\r\n        <!-- Image -->\r\n        <div class=\"relative\">\r\n            {% if product.image and product.image.name %}\r\n            <img src=\"{{ product.image.url }}\" alt=\"{{ product.name }}\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-lg\">\r\n            {% else %}\r\n            <div class=\"w-full h-[450px] flex items-center justify-center bg-gradient-to-br from-yellow-300 to-orange-400 rounded-2xl\">\r\n                <i class=\"fas fa-bowl-food text-white text-6xl opacity-60\"></i>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n\r\n        <!-- Info -->\r\n        <div class=\"space-y-4\">\r\n            <!-- Category + Brand Pills -->\r\n            <div class=\"flex flex-wrap gap-2\">\r\n                <span class=\"bg-blue-100 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full\">{{ product.category.name }}</span>\r\n                {% if product.brand %}\r\n                <a href=\"{% url 'eshop:products' %}?brand={{ product.brand.id }}\" class=\"bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1 rounded-full hover:bg-blue-50 hover:text-blue-700 transition\">{{ product.brand.name }}</a>\r\n                {% endif %}\r\n            </div>\r\n\r\n            <!-- Product Name -->\r\n            <h1 class=\"text-3xl font-extrabold text-gray-800\">{{ product.name }}</h1>\r\n\r\n            <!-- Price -->\r\n            <div class=\"text-3xl font-extrabold text-blue-600\">\r\n                {{ product.sale_price|floatformat:0 }}đ\r\n                {% if product.cost_price and product.cost_price > product.sale_price %}\r\n                <span class=\"text-gray-400 text-base line-through font-medium ml-2\">{{ product.cost_price|floatformat:0 }}đ</span>\r\n                {% endif %}\r\n            </div>\r\n\r\n            <!-- Description -->\r\n            <p class=\"text-gray-600 text-sm leading-relaxed\">{{ product.description|default:'Sản phẩm chất lượng từ ZenMart - Cửa Hàng Tiện Lợi.' }}</p>\r\n\r\n            <!-- Stock + Shipping -->\r\n            <div class=\"flex flex-wrap gap-4 text-sm font-semibold\">\r\n                <div class=\"flex items-center gap-1 {% if product.stock > product.min_stock %}text-green-600{% elif product.stock > 0 %}text-yellow-600{% else %}text-red-500{% endif %}\">\r\n                    <i class=\"fas fa-{% if product.stock > product.min_stock %}check-circle{% elif product.stock > 0 %}exclamation-circle{% else %}times-circle{% endif %}\"></i>\r\n                    {% if product.stock > product.min_stock %}Còn hàng ({{ product.stock }}){% elif product.stock > 0 %}Sắp hết ({{ product.stock }}){% else %}Hết hàng{% endif %}\r\n                </div>\r\n                <div class=\"flex items-center gap-1 text-gray-500\">\r\n                    <i class=\"fas fa-truck\"></i> Giao hàng nhanh\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Add to Cart -->\r\n            <form method=\"post\" action=\"{% url 'eshop:cart_add' product.pk %}\" class=\"flex flex-wrap gap-4 mt-4 items-center\">\r\n                {% csrf_token %}\r\n                <div class=\"flex items-center border rounded-lg overflow-hidden\">\r\n                    <button type=\"button\" class=\"px-3 py-1 bg-gray-100 hover:bg-gray-200 transition\" onclick=\"document.getElementById('qty').stepDown()\">−</button>\r\n                    <input type=\"number\" id=\"qty\" name=\"quantity\" value=\"1\" min=\"1\" max=\"{{ product.stock }}\" class=\"w-14 text-center outline-none\">\r\n                    <button type=\"button\" class=\"px-3 py-1 bg-gray-100 hover:bg-gray-200 transition\" onclick=\"document.getElementById('qty').stepUp()\">+</button>\r\n                </div>\r\n                <button type=\"submit\" class=\"flex-1 bg-gradient-to-r from-blue-600 to-purple-700 text-white font-semibold py-2 rounded-xl hover:opacity-90 transition flex items-center justify-center gap-2\" {% if product.stock == 0 %}disabled{% endif %}>\r\n                    <i class=\"fas fa-cart-plus\"></i> {% if product.stock > 0 %}Thêm vào giỏ{% else %}Hết hàng{% endif %}\r\n                </button>\r\n            </form>\r\n\r\n            <!-- Features -->\r\n            <div class=\"grid grid-cols-2 gap-3 mt-6\">\r\n                <div class=\"flex items-center gap-2 bg-blue-50 text-blue-600 px-3 py-2 rounded-lg font-semibold text-sm\">\r\n                    <i class=\"fas fa-shield-alt\"></i> Chính hãng 100%\r\n                </div>\r\n                <div class=\"flex items-center gap-2 bg-green-50 text-green-600 px-3 py-2 rounded-lg font-semibold text-sm\">\r\n                    <i class=\"fas fa-undo\"></i> Đổi trả dễ dàng\r\n                </div>\r\n                <div class=\"flex items-center gap-2 bg-orange-50 text-orange-600 px-3 py-2 rounded-lg font-semibold text-sm\">\r\n                    <i class=\"fas fa-truck-fast\"></i> Giao hàng nhanh\r\n                </div>\r\n                <div class=\"flex items-center gap-2 bg-purple-50 text-purple-600 px-3 py-2 rounded-lg font-semibold text-sm\">\r\n                    <i class=\"fas fa-headset\"></i> Hỗ trợ 24/7\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Reviews Section -->\r\n    <div class=\"space-y-6\">\r\n        <h2 class=\"text-xl font-bold flex items-center gap-2\"><i class=\"fas fa-star text-yellow-500\"></i> Đánh giá sản phẩm</h2>\r\n\r\n        <!-- Review Form -->\r\n        {% if user_can_review and not user_review %}\r\n        <div class=\"bg-gray-100 rounded-2xl p-6\">\r\n            <h3 class=\"font-semibold text-gray-800 mb-4\">Viết đánh giá của bạn</h3>\r\n            <form method=\"post\" enctype=\"multipart/form-data\" class=\"space-y-4\">\r\n                {% csrf_token %}\r\n                <div class=\"flex gap-2\">\r\n                    {% for i in \"12345\" %}\r\n                    <label class=\"cursor-pointer\">\r\n                        <input type=\"radio\" name=\"rating\" value=\"{{ i }}\" required class=\"hidden\">\r\n                        <span class=\"text-2xl text-gray-300 hover:text-yellow-400 transition\">★</span>\r\n                    </label>\r\n                    {% endfor %}\r\n                </div>\r\n                <textarea name=\"comment\" rows=\"4\" placeholder=\"Chia sẻ trải nghiệm...\" class=\"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none\"></textarea>\r\n                <input type=\"file\" name=\"images\" multiple accept=\"image/*\" class=\"w-full\">\r\n                <button type=\"submit\" class=\"w-full bg-gradient-to-r from-blue-600 to-purple-700 text-white py-2 rounded-xl font-semibold hover:opacity-90 transition flex items-center justify-center gap-2\">\r\n                    <i class=\"fas fa-paper-plane\"></i> Gửi đánh giá\r\n                </button>\r\n            </form>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Reviews List -->\r\n        {% if reviews %}\r\n        <div class=\"grid gap-4\">\r\n            {% for review in reviews %}\r\n            <div class=\"bg-white p-4 rounded-2xl shadow hover:shadow-lg transition\">\r\n                <div class=\"flex justify-between mb-2\">\r\n                    <div>\r\n                        <div class=\"font-semibold\">{{ review.user.get_full_name|default:review.user.email }}</div>\r\n                        <div class=\"flex gap-1\">\r\n                            {% for i in \"12345\" %}\r\n                            <span class=\"{% if forloop.counter <= review.rating %}text-yellow-400{% else %}text-gray-300{% endif %}\">★</span>\r\n                            {% endfor %}\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"text-gray-400 text-sm\">{{ review.created_at|date:\"d/m/Y\" }}</div>\r\n                </div>\r\n                {% if review.content %}\r\n                <p class=\"text-gray-600 text-sm\">{{ review.content }}</p>\r\n                {% endif %}\r\n                {% if review.images.all %}\r\n                <div class=\"flex gap-2 flex-wrap mt-2\">\r\n                    {% for img in review.images.all %}\r\n                    <img src=\"{{ img.image.url }}\" class=\"w-20 h-20 object-cover rounded-lg cursor-pointer\" onclick=\"window.open(this.src)\">\r\n                    {% endfor %}\r\n                </div>\r\n                {% endif %}\r\n            </div>\r\n            {% endfor %}\r\n        </div>\r\n        {% else %}\r\n        <div class=\"text-center py-12 bg-white rounded-2xl shadow\">\r\n            <i class=\"fas fa-star text-4xl text-gray-300 mb-2\"></i>\r\n            <h3 class=\"text-gray-600 font-semibold\">Chưa có đánh giá nào</h3>\r\n            <p class=\"text-gray-400\">Hãy là người đầu tiên đánh giá sản phẩm này!</p>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- Related Products -->\r\n    {% if related_products %}\r\n    <div>\r\n        <h2 class=\"text-xl font-bold flex items-center gap-2 mb-4\"><i class=\"fas fa-heart text-red-500\"></i> Sản Phẩm Tương Tự</h2>\r\n        <div class=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4\">\r\n            {% for product in related_products %}\r\n            {% include 'eshop/_product_card.html' %}\r\n            {% endfor %}\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n</div>\r\n\r\n{% endblock %}"
        }
    ]
}