            "date": 1779353986127,
            "name": "Commit-0",
            "content": "{% extends 'eshop/base.html' %}\r\n{% load static %}\r\n{% block title %}Tra Cứu Đơn Hàng{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"max-w-4xl mx-auto px-6 py-12\">\r\n\r\n    <!-- Header -->\r\n    <div class=\"text-center mb-8\">\r\n        <div class=\"w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-blue-600 to-purple-700 flex items-center justify-center mb-4\">\r\n            <i class=\"fas fa-search text-white text-2xl\"></i>\r\n        </div>\r\n        <h1 class=\"text-2xl font-extrabold text-gray-800\">Tra Cứu Đơn Hàng</h1>\r\n        <p class=\"text-gray-500 text-sm\">Nhập mã đơn hàng để xem chi tiết</p>\r\n    </div>\r\n\r\n    <!-- Search Form -->\r\n    <div class=\"bg-white rounded-2xl shadow-xl p-6 mb-8\">\r\n        <form method=\"post\" class=\"flex gap-2\">\r\n            {% csrf_token %}\r\n            <input type=\"text\" name=\"order_id\" value=\"{{ form.order_id.value|default_if_none:'' }}\" placeholder=\"Mã đơn hàng\"\r\n                   class=\"flex-1 border rounded-full px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none\">\r\n            <button type=\"submit\" class=\"bg-blue-600 text-white px-4 py-2 rounded-full hover:bg-blue-700 transition flex items-center gap-2\">\r\n                <i class=\"fas fa-search\"></i> Tìm\r\n            </button>\r\n        </form>\r\n        {% if form.order_id.errors %}\r\n        <p class=\"text-red-500 text-xs mt-2\">{{ form.order_id.errors.0 }}</p>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- Order Details -->\r\n    {% if order %}\r\n    <div class=\"bg-white rounded-2xl shadow-xl p-6 space-y-4\">\r\n\r\n        <!-- Header -->\r\n        <div class=\"flex justify-between items-center\">\r\n            <h3 class=\"flex items-center gap-2 font-semibold text-gray-800\">\r\n                <i class=\"fas fa-receipt text-blue-600\"></i> Đơn Hàng\r\n            </h3>\r\n            <span class=\"px-3 py-1 rounded-full text-sm font-semibold\r\n                {% if order.status == 'pending' %}bg-yellow-100 text-yellow-700\r\n                {% elif order.status == 'delivered' %}bg-green-100 text-green-700\r\n                {% else %}bg-gray-100 text-gray-700{% endif %}\">\r\n                {{ order.get_status_display }}\r\n            </span>\r\n        </div>\r\n\r\n        <!-- Order Info -->\r\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-700\">\r\n            <div class=\"flex justify-between\">\r\n                <span>Mã đơn hàng:</span>\r\n                <span class=\"font-mono font-semibold text-blue-600\">{{ order.order_id }}</span>\r\n            </div>\r\n            <div class=\"flex justify-between\">\r\n                <span>Người nhận:</span>\r\n                <span>{{ order.full_name }}</span>\r\n            </div>\r\n            <div class=\"flex justify-between\">\r\n                <span>Số điện thoại:</span>\r\n                <span>{{ order.phone_number }}</span>\r\n            </div>\r\n            <div class=\"flex justify-between\">\r\n                <span>Địa chỉ:</span>\r\n                <span class=\"text-right\">{{ order.shipping_address }}</span>\r\n            </div>\r\n            <div class=\"flex justify-between\">\r\n                <span>Ngày đặt:</span>\r\n                <span>{{ order.created_at|date:'d/m/Y H:i' }}</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Order Items -->\r\n        <div class=\"mt-4 border-t pt-4 space-y-2\">\r\n            <h4 class=\"text-gray-500 uppercase text-xs font-semibold mb-2\">Sản phẩm</h4>\r\n            {% for item in order.items.all %}\r\n            <div class=\"flex justify-between items-center p-2 border-b\">\r\n                <div>\r\n                    <p class=\"font-semibold text-gray-800 text-sm\">{{ item.product.name }}</p>\r\n                    <p class=\"text-gray-500 text-xs\">{{ item.quantity }} x {{ item.unit_price|floatformat:0 }}đ</p>\r\n                </div>\r\n                <p class=\"font-semibold text-gray-800\">{{ item.total_price|floatformat:0 }}đ</p>\r\n            </div>\r\n            {% endfor %}\r\n        </div>\r\n\r\n        <!-- Total -->\r\n        <div class=\"flex justify-between mt-4 text-lg font-bold text-gray-800\">\r\n            <span>Tổng cộng</span>\r\n            <span class=\"text-blue-600\">{{ order.total_amount|floatformat:0 }}đ</span>\r\n        </div>\r\n\r\n        <!-- Status Timeline -->\r\n        <div class=\"mt-6 border-t pt-4\">\r\n            <h4 class=\"text-gray-500 uppercase text-xs font-semibold mb-2\">Trạng Thái Đơn Hàng</h4>\r\n            <div class=\"flex flex-col gap-3\">\r\n                {% for status_code, status_name in order.STATUS_CHOICES %}\r\n                <div class=\"flex items-center gap-3\">\r\n                    <div class=\"w-7 h-7 rounded-full flex items-center justify-center\r\n                        {% if order.status == status_code %}bg-blue-600 text-white{% else %}bg-gray-200 text-gray-500{% endif %}\">\r\n                        {% if order.status == status_code %}<i class=\"fas fa-check text-xs\"></i>{% endif %}\r\n                    </div>\r\n                    <span class=\"{% if order.status == status_code %}font-semibold text-gray-800{% else %}text-gray-400{% endif %}\">{{ status_name }}</span>\r\n                </div>\r\n                {% endfor %}\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n    {% endif %}\r\n\r\n</div>\r\n{% endblock %}"
        }
    ]
}