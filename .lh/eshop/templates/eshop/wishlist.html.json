            "date": 1779354637284,
            "name": "Commit-0",
            "content": "{% extends 'eshop/base.html' %}\r\n{% block title %}Danh sách yêu thích - ZenMart{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"max-w-7xl mx-auto px-6 py-12 space-y-8\">\r\n\r\n    <!-- Header -->\r\n    <div class=\"flex flex-col md:flex-row justify-between items-center mb-6\">\r\n        <h1 class=\"text-2xl md:text-3xl font-extrabold text-gray-800 flex items-center gap-2\">\r\n            <i class=\"fas fa-heart text-red-500\"></i> Danh sách yêu thích\r\n        </h1>\r\n        <div class=\"text-gray-500 text-sm mt-2 md:mt-0\">\r\n            {{ wishlist_items|length }} sản phẩm\r\n        </div>\r\n    </div>\r\n\r\n    {% if wishlist_items %}\r\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\r\n        {% for item in wishlist_items %}\r\n        <div class=\"bg-white rounded-2xl shadow-md hover:shadow-xl transform hover:-translate-y-1 transition relative flex flex-col overflow-hidden\">\r\n            \r\n            <!-- Product image -->\r\n            <a href=\"{% url 'eshop:product_detail' item.product.pk %}\">\r\n                {% if item.product.image %}\r\n                <img src=\"{{ item.product.image.url }}\" alt=\"{{ item.product.name }}\" class=\"w-full h-48 object-cover\">\r\n                {% else %}\r\n                <div class=\"w-full h-48 bg-gray-200 flex items-center justify-center\">\r\n                    <i class=\"fas fa-bowl-food text-gray-400 text-4xl\"></i>\r\n                </div>\r\n                {% endif %}\r\n            </a>\r\n\r\n            <!-- Product info -->\r\n            <div class=\"p-4 flex-1 flex flex-col justify-between\">\r\n                <div>\r\n                    <div class=\"font-semibold text-gray-800 mb-2 line-clamp-2\">{{ item.product.name }}</div>\r\n                    <div class=\"text-blue-600 font-bold text-lg mb-2\">{{ item.product.sale_price|floatformat:0 }}đ</div>\r\n                </div>\r\n\r\n                <!-- Actions -->\r\n                <div class=\"flex gap-2 mt-4\">\r\n                    <form method=\"post\" action=\"{% url 'eshop:cart_add' item.product.pk %}\" class=\"flex-1\">\r\n                        {% csrf_token %}\r\n                        <input type=\"hidden\" name=\"quantity\" value=\"1\">\r\n                        <button type=\"submit\" class=\"bg-blue-600 text-white py-2 rounded-xl w-full flex items-center justify-center gap-2 hover:bg-blue-700 transition\">\r\n                            <i class=\"fas fa-cart-plus\"></i> Thêm vào giỏ\r\n                        </button>\r\n                    </form>\r\n                    <a href=\"{% url 'eshop:remove_from_wishlist' item.product.pk %}\" class=\"border border-gray-300 rounded-xl py-2 px-3 flex items-center justify-center text-gray-600 hover:bg-gray-100 transition\">\r\n                        <i class=\"fas fa-trash\"></i>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n        {% endfor %}\r\n    </div>\r\n    {% else %}\r\n    <!-- Empty state -->\r\n    <div class=\"bg-white rounded-2xl shadow-md p-12 text-center space-y-4\">\r\n        <i class=\"fas fa-heart text-6xl text-gray-300\"></i>\r\n        <h3 class=\"text-xl font-semibold text-gray-700\">Chưa có sản phẩm yêu thích</h3>\r\n        <p class=\"text-gray-400\">Bạn chưa thêm sản phẩm nào vào danh sách yêu thích</p>\r\n        <a href=\"{% url 'eshop:products' %}\" class=\"inline-flex items-center gap-2 bg-blue-600 text-white py-3 px-6 rounded-xl font-semibold hover:bg-blue-700 transition\">\r\n            <i class=\"fas fa-shopping-bag\"></i> Khám phá sản phẩm\r\n        </a>\r\n    </div>\r\n    {% endif %}\r\n\r\n</div>\r\n{% endblock %}"
        }
    ]
}