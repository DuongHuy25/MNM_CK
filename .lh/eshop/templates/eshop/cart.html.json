            "date": 1779352906437,
            "name": "Commit-0",
            "content": "{% extends 'eshop/base.html' %}\r\n{% load static %}\r\n{% block title %}Giỏ Hàng - ZenMart{% endblock %}\r\n{% block content %}\r\n\r\n<div class=\"max-w-7xl mx-auto px-6 py-12 space-y-8\">\r\n\r\n    <h1 class=\"text-2xl md:text-3xl font-bold text-gray-800 mb-6 flex items-center gap-2\">\r\n        <i class=\"fas fa-shopping-cart text-blue-600\"></i> Giỏ Hàng\r\n    </h1>\r\n\r\n    {% if cart|length > 0 %}\r\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\r\n\r\n        <!-- Cart Items -->\r\n        <div class=\"lg:col-span-2 space-y-4\">\r\n            <div class=\"overflow-x-auto\">\r\n                <table class=\"min-w-full bg-white rounded-xl shadow\">\r\n                    <thead class=\"bg-gray-100\">\r\n                        <tr>\r\n                            <th class=\"p-3 text-left text-gray-600\">Sản phẩm</th>\r\n                            <th class=\"p-3 text-center text-gray-600\">Giá</th>\r\n                            <th class=\"p-3 text-center text-gray-600\">Số lượng</th>\r\n                            <th class=\"p-3 text-center text-gray-600\">Thành tiền</th>\r\n                            <th class=\"p-3\"></th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody>\r\n                        {% for item in cart %}\r\n                        <tr class=\"border-b hover:bg-gray-50 transition\">\r\n                            <td class=\"p-3\">\r\n                                <div class=\"flex items-center gap-4\">\r\n                                    {% if item.product.image and item.product.image.name %}\r\n                                    <img src=\"{{ item.product.image.url }}\" alt=\"{{ item.product.name }}\" class=\"w-20 h-20 object-cover rounded-lg\">\r\n                                    {% else %}\r\n                                    <div class=\"w-20 h-20 bg-gray-100 flex items-center justify-center rounded-lg text-gray-400 text-2xl\">\r\n                                        <i class=\"fas fa-bowl-food\"></i>\r\n                                    </div>\r\n                                    {% endif %}\r\n                                    <div>\r\n                                        <div class=\"font-semibold text-gray-800\">{{ item.product.name }}</div>\r\n                                        <div class=\"text-sm text-gray-500\">{{ item.product.category.name }}</div>\r\n                                    </div>\r\n                                </div>\r\n                            </td>\r\n                            <td class=\"p-3 text-center font-semibold text-blue-600\">{{ item.price|floatformat:0 }}đ</td>\r\n                            <td class=\"p-3 text-center\">\r\n                                <form method=\"post\" action=\"{% url 'eshop:cart_update' item.product.pk %}\" class=\"inline-flex items-center gap-1\">\r\n                                    {% csrf_token %}\r\n                                    <button type=\"submit\" name=\"quantity\" value=\"{{ item.quantity|add:\"-1\" }}\" class=\"w-6 h-6 bg-gray-200 rounded hover:bg-gray-300 transition\">−</button>\r\n                                    <input type=\"text\" name=\"quantity\" value=\"{{ item.quantity }}\" class=\"w-10 text-center border rounded text-sm\" readonly>\r\n                                    <button type=\"submit\" name=\"quantity\" value=\"{{ item.quantity|add:\"1\" }}\" class=\"w-6 h-6 bg-gray-200 rounded hover:bg-gray-300 transition\">+</button>\r\n                                </form>\r\n                            </td>\r\n                            <td class=\"p-3 text-center font-semibold text-gray-800\">{{ item.total_price|floatformat:0 }}đ</td>\r\n                            <td class=\"p-3 text-center\">\r\n                                <form method=\"post\" action=\"{% url 'eshop:cart_remove' item.product.pk %}\">\r\n                                    {% csrf_token %}\r\n                                    <button type=\"submit\" class=\"text-red-500 hover:text-red-700\"><i class=\"fas fa-trash\"></i></button>\r\n                                </form>\r\n                            </td>\r\n                        </tr>\r\n                        {% endfor %}\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Summary -->\r\n        <div class=\"bg-white p-6 rounded-2xl shadow-lg h-fit space-y-4\">\r\n            <h3 class=\"font-bold text-lg flex items-center gap-2\">\r\n                <i class=\"fas fa-receipt text-blue-600\"></i> Tóm Tắt Đơn Hàng\r\n            </h3>\r\n            <div class=\"flex justify-between text-gray-600\">\r\n                <span>Tạm tính ({{ cart|length }} sản phẩm)</span>\r\n                <span>{{ cart.get_total_price|floatformat:0 }}đ</span>\r\n            </div>\r\n            <div class=\"flex justify-between text-gray-600\">\r\n                <span>Phí giao hàng</span>\r\n                <span class=\"text-green-500 font-semibold\">Miễn phí</span>\r\n            </div>\r\n            <div class=\"flex justify-between font-bold text-gray-800 text-lg\">\r\n                <span>Tổng cộng</span>\r\n                <span>{{ cart.get_total_price|floatformat:0 }}đ</span>\r\n            </div>\r\n            <a href=\"{% url 'eshop:checkout' %}\" class=\"block w-full text-center bg-gradient-to-r from-blue-600 to-purple-700 text-white py-3 rounded-xl font-semibold hover:opacity-90 transition\">\r\n                <i class=\"fas fa-lock mr-2\"></i> Thanh Toán\r\n            </a>\r\n            <a href=\"{% url 'eshop:products' %}\" class=\"block text-center text-blue-600 font-semibold hover:underline\">\r\n                ← Tiếp tục mua sắm\r\n            </a>\r\n        </div>\r\n    </div>\r\n\r\n    {% else %}\r\n    <!-- Empty state -->\r\n    <div class=\"flex flex-col items-center justify-center py-24 space-y-4 text-gray-400\">\r\n        <i class=\"fas fa-shopping-cart text-6xl\"></i>\r\n        <h3 class=\"text-xl font-semibold\">Giỏ hàng trống</h3>\r\n        <p>Hãy thêm sản phẩm vào giỏ hàng</p>\r\n        <a href=\"{% url 'eshop:products' %}\" class=\"bg-blue-600 text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition inline-flex items-center gap-2\">\r\n            <i class=\"fas fa-shopping-bag\"></i> Mua Sắm Ngay\r\n        </a>\r\n    </div>\r\n    {% endif %}\r\n\r\n</div>\r\n\r\n{% endblock %}"
        }
    ]
}