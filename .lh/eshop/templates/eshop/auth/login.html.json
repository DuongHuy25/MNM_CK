            "date": 1779347738861,
            "name": "Commit-0",
            "content": "{% extends 'eshop/base.html' %}\r\n{% block title %}Đăng Nhập{% endblock %}\r\n{% block content %}\r\n<div style=\"max-width:440px;margin:3rem auto;\">\r\n    <div class=\"summary-card\" style=\"padding:2.5rem;\">\r\n        <div style=\"text-align:center;margin-bottom:2rem;\">\r\n            <div style=\"width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;\">\r\n                <i class=\"fas fa-user\" style=\"font-size:1.5rem;color:white;\"></i>\r\n            </div>\r\n            <h2 style=\"font-size:1.5rem;font-weight:800;color:#2d3436;\">Đăng Nhập</h2>\r\n            <p style=\"color:#636e72;font-size:.9rem;\">Đăng nhập để theo dõi đơn hàng và mua sắm</p>\r\n        </div>\r\n\r\n        {% if form.non_field_errors %}\r\n        <div class=\"msg msg-error\" style=\"margin-bottom:1rem;\">\r\n            {% for err in form.non_field_errors %}{{ err }}{% endfor %}\r\n        </div>\r\n        {% endif %}\r\n\r\n        <form method=\"post\">\r\n            {% csrf_token %}\r\n            <input type=\"hidden\" name=\"next\" value=\"{{ next }}\">\r\n            <div class=\"form-group\">\r\n                <label>{{ form.email.label }}</label>\r\n                {{ form.email }}\r\n                {% if form.email.errors %}\r\n                <div style=\"color:#f5365c;font-size:.8rem;margin-top:4px;\">{{ form.email.errors.0 }}</div>\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"form-group\">\r\n                <label>{{ form.password.label }}</label>\r\n                {{ form.password }}\r\n                {% if form.password.errors %}\r\n                <div style=\"color:#f5365c;font-size:.8rem;margin-top:4px;\">{{ form.password.errors.0 }}</div>\r\n                {% endif %}\r\n            </div>\r\n            <button type=\"submit\" class=\"btn-primary\" style=\"width:100%;padding:14px;font-size:1rem;margin-top:.5rem;\">\r\n                <i class=\"fas fa-sign-in-alt\"></i> Đăng Nhập\r\n            </button>\r\n        </form>\r\n\r\n        <div style=\"text-align:center;margin-top:1.25rem;font-size:.85rem;color:#636e72;\">\r\n            Chưa có tài khoản? <a href=\"{% url 'eshop:register' %}\" style=\"color:#667eea;font-weight:700;\">Đăng ký ngay</a>\r\n        </div>\r\n        <div style=\"text-align:center;margin-top:.5rem;\">\r\n            <a href=\"{% url 'eshop:forgot_password' %}\" style=\"font-size:.82rem;color:#636e72;\"><i class=\"fas fa-key\"></i> Quên mật khẩu?</a>\r\n        </div>\r\n    </div>\r\n</div>\r\n{% endblock %}\r\n"
        }
    ]
