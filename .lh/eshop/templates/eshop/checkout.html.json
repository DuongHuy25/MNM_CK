            "name": "Commit-0",
            "content": "{% extends 'eshop/base.html' %}\r\n{% block title %}Thanh Toán - ZenMart{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"max-w-7xl mx-auto px-6 py-12 space-y-8\">\r\n\r\n    <h1 class=\"text-2xl md:text-3xl font-bold text-gray-800 mb-6 flex items-center gap-2\">\r\n        <i class=\"fas fa-lock text-blue-600\"></i> Thanh Toán\r\n    </h1>\r\n\r\n    <form method=\"post\" id=\"checkoutForm\" class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\r\n        {% csrf_token %}\r\n\r\n        <!-- Checkout Form -->\r\n        <div class=\"lg:col-span-2 space-y-6\">\r\n\r\n            <!-- Shipping Info -->\r\n            <div class=\"bg-white p-6 rounded-2xl shadow-lg space-y-4\">\r\n                <h3 class=\"text-lg font-semibold flex items-center gap-2\"><i class=\"fas fa-truck text-blue-600\"></i> Thông Tin Giao Hàng</h3>\r\n                <div class=\"space-y-3\">\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium\">{{ form.full_name.label }}</label>\r\n                        {{ form.full_name|add_class:\"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500\" }}\r\n                        {% if form.full_name.errors %}\r\n                        <div class=\"text-red-500 text-xs mt-1\">{{ form.full_name.errors.0 }}</div>\r\n                        {% endif %}\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium\">{{ form.phone_number.label }}</label>\r\n                        {{ form.phone_number|add_class:\"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500\" }}\r\n                        {% if form.phone_number.errors %}\r\n                        <div class=\"text-red-500 text-xs mt-1\">{{ form.phone_number.errors.0 }}</div>\r\n                        {% endif %}\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium\">{{ form.shipping_address.label }}</label>\r\n                        {{ form.shipping_address|add_class:\"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500\" }}\r\n                        {% if form.shipping_address.errors %}\r\n                        <div class=\"text-red-500 text-xs mt-1\">{{ form.shipping_address.errors.0 }}</div>\r\n                        {% endif %}\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium\">{{ form.note.label }}</label>\r\n                        {{ form.note|add_class:\"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500\" }}\r\n                    </div>\r\n\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium\">{{ form.delivery_time_slot.label }}</label>\r\n                        {{ form.delivery_time_slot|add_class:\"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500\" }}\r\n                        <p class=\"text-xs text-gray-500 mt-1\"><i class=\"fas fa-clock\"></i> Chọn khung giờ giao hàng phù hợp</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Payment Method -->\r\n            <div class=\"bg-white p-6 rounded-2xl shadow-lg space-y-4\">\r\n                <h3 class=\"text-lg font-semibold flex items-center gap-2\"><i class=\"fas fa-credit-card text-blue-600\"></i> Phương Thức Thanh Toán</h3>\r\n                <div class=\"flex flex-col space-y-2\">\r\n                    {% for choice in form.payment_method %}\r\n                    <label class=\"flex items-center gap-2 p-3 border rounded-lg hover:bg-blue-50 cursor-pointer\" onclick=\"showPaymentDetail('{{ choice.data.value }}')\">\r\n                        {{ choice.tag }}\r\n                        <span class=\"font-medium text-gray-800\">{{ choice.choice_label }}</span>\r\n                    </label>\r\n                    {% endfor %}\r\n                </div>\r\n\r\n                <!-- COD -->\r\n                <div id=\"pay-cod\" class=\"payment-detail hidden mt-2 p-4 rounded-lg bg-green-50 flex items-center gap-3\">\r\n                    <i class=\"fas fa-hand-holding-usd text-green-600 text-xl\"></i>\r\n                    <div>\r\n                        <div class=\"font-semibold text-gray-800\">Thanh toán khi nhận hàng</div>\r\n                        <div class=\"text-sm text-gray-500\">Thanh toán bằng tiền mặt khi giao hàng.</div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Bank -->\r\n                <div id=\"pay-bank\" class=\"payment-detail hidden mt-2 p-4 rounded-lg bg-blue-50\">\r\n                    <div class=\"flex items-center gap-2 mb-2\">\r\n                        <i class=\"fas fa-university text-blue-600 text-xl\"></i>\r\n                        <span class=\"font-semibold text-gray-800\">Chuyển khoản ngân hàng</span>\r\n                    </div>\r\n                    <div class=\"bg-white rounded-lg p-3 text-sm space-y-1\">\r\n                        <div class=\"grid grid-cols-2 gap-2\">\r\n                            <span class=\"font-medium text-gray-500\">Ngân hàng:</span>\r\n                            <span class=\"font-semibold text-gray-800\">Vietcombank</span>\r\n                            <span class=\"font-medium text-gray-500\">Số tài khoản:</span>\r\n                            <span class=\"font-mono font-semibold text-gray-800\">1234 5678 9012 345</span>\r\n                            <span class=\"font-medium text-gray-500\">Chủ tài khoản:</span>\r\n                            <span class=\"font-semibold text-gray-800\">CÔNG TY ZENMART VN</span>\r\n                            <span class=\"font-medium text-gray-500\">Nội dung CK:</span>\r\n                            <span class=\"font-mono font-semibold text-blue-600\">ZENMART [Mã đơn hàng]</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- MoMo -->\r\n                <div id=\"pay-momo\" class=\"payment-detail hidden mt-2 p-4 rounded-lg bg-pink-50\">\r\n                    <div class=\"flex items-center gap-3 mb-2\">\r\n                        <div class=\"w-8 h-8 bg-pink-600 rounded flex items-center justify-center text-white text-sm\"><i class=\"fas fa-wallet\"></i></div>\r\n                        <span class=\"font-semibold text-gray-800\">Ví MoMo</span>\r\n                    </div>\r\n                    <div class=\"bg-white rounded-lg p-3 text-center text-sm\">\r\n                        Quét mã QR để thanh toán MoMo\r\n                        <div class=\"w-36 h-36 mx-auto mt-2 bg-gray-200 rounded-lg\"></div>\r\n                        <p class=\"mt-1 text-gray-500 text-xs\">Số điện thoại: <span class=\"text-gray-800 font-semibold\">0909 123 456</span></p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Order Summary -->\r\n        <div class=\"bg-white p-6 rounded-2xl shadow-lg\">\r\n            <h3 class=\"text-lg font-semibold flex items-center gap-2\"><i class=\"fas fa-receipt text-blue-600\"></i> Đơn Hàng Của Bạn</h3>\r\n            <div class=\"space-y-2 mt-4\">\r\n                {% for item in cart %}\r\n                <div class=\"flex items-center gap-3 p-2 border-b\">\r\n                    {% if item.product.image and item.product.image.name %}\r\n                    <img src=\"{{ item.product.image.url }}\" class=\"w-12 h-12 object-cover rounded-lg\">\r\n                    {% else %}\r\n                    <div class=\"w-12 h-12 bg-gradient-to-br from-yellow-300 to-orange-400 rounded-lg flex items-center justify-center text-white\">\r\n                        <i class=\"fas fa-bowl-food\"></i>\r\n                    </div>\r\n                    {% endif %}\r\n                    <div class=\"flex-1\">\r\n                        <div class=\"font-semibold text-gray-800 text-sm\">{{ item.product.name }}</div>\r\n                        <div class=\"text-xs text-gray-500\">{{ item.quantity }} x {{ item.price|floatformat:0 }}đ</div>\r\n                    </div>\r\n                    <div class=\"font-semibold text-gray-800 text-sm\">{{ item.total_price|floatformat:0 }}đ</div>\r\n                </div>\r\n                {% endfor %}\r\n            </div>\r\n\r\n            <!-- Discount Code -->\r\n            <div class=\"mt-4 flex gap-2\">\r\n                <input type=\"text\" id=\"discountCodeInput\" placeholder=\"Nhập mã giảm giá\" class=\"flex-1 border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500\">\r\n                <button type=\"button\" id=\"applyDiscountBtn\" class=\"bg-blue-600 text-white px-4 py-2 rounded-lg hover:opacity-90 transition text-sm\">Áp dụng</button>\r\n            </div>\r\n            <div id=\"discountMessage\" class=\"text-xs mt-1\"></div>\r\n\r\n            <!-- Total -->\r\n            <div class=\"mt-4 space-y-1 text-sm\">\r\n                <div class=\"flex justify-between\">\r\n                    <span>Tạm tính</span>\r\n                    <span id=\"subtotal\">{{ cart.get_total_price|floatformat:0 }}đ</span>\r\n                </div>\r\n                <div id=\"discountRow\" class=\"flex justify-between text-green-600 font-semibold hidden\">\r\n                    <span>Giảm giá</span>\r\n                    <span id=\"discountAmount\">-0đ</span>\r\n                </div>\r\n                <div class=\"flex justify-between text-green-600 font-semibold\">\r\n                    <span>Phí giao hàng</span>\r\n                    <span id=\"shippingFee\">Đang tính...</span>\r\n                </div>\r\n                <div class=\"flex justify-between font-bold text-gray-800 text-lg\">\r\n                    <span>Tổng cộng</span>\r\n                    <span id=\"totalAmount\">{{ cart.get_total_price|floatformat:0 }}đ</span>\r\n                </div>\r\n            </div>\r\n\r\n            <button type=\"submit\" class=\"w-full mt-4 py-3 bg-gradient-to-r from-blue-600 to-purple-700 text-white font-semibold rounded-xl hover:opacity-90 transition flex items-center justify-center gap-2\">\r\n                <i class=\"fas fa-check-circle\"></i> Xác Nhận Đặt Hàng\r\n            </button>\r\n            <a href=\"{% url 'eshop:cart' %}\" class=\"block text-center mt-2 text-blue-600 font-semibold hover:underline\">← Quay lại giỏ hàng</a>\r\n        </div>\r\n    </form>\r\n</div>\r\n{% endblock %}"
        }
    ]
}