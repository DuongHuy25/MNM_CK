            "content": "<!DOCTYPE html>\r\n<html lang=\"vi\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>{% block title %}ZenMart{% endblock %}</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\r\n</head>\r\n<body class=\"bg-gray-100 min-h-screen flex flex-col\">\r\n\r\n    <!-- Navbar -->\r\n    <header class=\"bg-white shadow sticky top-0 z-50\">\r\n        <div class=\"max-w-7xl mx-auto px-6 py-3 flex items-center justify-between gap-4\">\r\n            <a href=\"{% url 'eshop:home' %}\" class=\"flex items-center gap-2 text-2xl font-bold text-blue-600 flex-shrink-0\">\r\n                <i class=\"fas fa-store\"></i> ZenMart\r\n            </a>\r\n\r\n            <!-- Nav links -->\r\n            <nav class=\"hidden md:flex items-center gap-6 text-gray-700 font-medium\">\r\n                <a href=\"{% url 'eshop:home' %}\" class=\"hover:text-blue-600 transition\">Trang chủ</a>\r\n                <a href=\"{% url 'eshop:products' %}\" class=\"hover:text-blue-600 transition\">Sản phẩm</a>\r\n                <a href=\"{% url 'eshop:directions' %}\" class=\"hover:text-blue-600 transition\">Tìm đường</a>\r\n                <div class=\"relative group\">\r\n                    <button class=\"flex items-center gap-1 hover:text-blue-600 transition\">\r\n                        <i class=\"fas fa-users\"></i> Về chúng tôi <i class=\"fas fa-chevron-down text-xs\"></i>\r\n                    </button>\r\n                    <ul class=\"absolute left-0 mt-2 w-48 bg-white shadow-lg rounded-lg opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all\">\r\n                        <li><a href=\"{% url 'eshop:about' %}\" class=\"block px-4 py-2 hover:bg-gray-100\"><i class=\"fas fa-info-circle mr-2\"></i> Giới thiệu</a></li>\r\n                        <li><a href=\"{% url 'eshop:news' %}\" class=\"block px-4 py-2 hover:bg-gray-100\"><i class=\"fas fa-newspaper mr-2\"></i> Tin tức</a></li>\r\n                        <li><a href=\"{% url 'eshop:contact' %}\" class=\"block px-4 py-2 hover:bg-gray-100\"><i class=\"fas fa-address-book mr-2\"></i> Liên hệ</a></li>\r\n                    </ul>\r\n                </div>\r\n            </nav>\r\n\r\n            <!-- Search -->\r\n            <div class=\"flex-1 max-w-lg mx-4\">\r\n                <form method=\"get\" action=\"{% url 'eshop:products' %}\" class=\"flex items-center w-full\">\r\n                    <input type=\"text\" name=\"q\" placeholder=\"Tìm sản phẩm...\" value=\"{{ request.GET.q }}\" class=\"w-full border-2 border-gray-300 rounded-l-full px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none\">\r\n                    <button class=\"bg-blue-600 text-white px-3 py-2 rounded-r-full hover:bg-blue-700 transition\">\r\n                        <i class=\"fas fa-search\"></i>\r\n                    </button>\r\n                </form>\r\n            </div>\r\n\r\n            <!-- Right controls -->\r\n            <div class=\"flex items-center gap-3 flex-shrink-0\">\r\n                {% if user.is_authenticated %}\r\n                <a href=\"{% url 'eshop:wishlist' %}\" class=\"flex items-center gap-1 font-semibold bg-pink-100 text-pink-600 hover:bg-pink-600 hover:text-white px-4 py-2 rounded-full transition\">\r\n                    <i class=\"fas fa-heart\"></i> Yêu thích\r\n                </a>\r\n                <a href=\"{% url 'eshop:profile' %}\" class=\"flex items-center gap-1 font-semibold bg-green-100 text-green-700 hover:bg-green-700 hover:text-white px-4 py-2 rounded-full transition\">\r\n                    {% if user.avatar %}\r\n                    <img src=\"{{ user.avatar.url }}\" class=\"w-7 h-7 rounded-full object-cover\">\r\n                    {% else %}\r\n                    <i class=\"fas fa-user-circle\"></i>\r\n                    {% endif %}\r\n                    {{ user.first_name|default:user.email }}\r\n                </a>\r\n                {% else %}\r\n                <a href=\"{% url 'eshop:login' %}\" class=\"flex items-center gap-1 font-semibold bg-gray-100 hover:bg-blue-600 hover:text-white px-4 py-2 rounded-full transition\">\r\n                    <i class=\"fas fa-sign-in-alt\"></i> Đăng nhập\r\n                </a>\r\n                <a href=\"{% url 'eshop:register' %}\" class=\"flex items-center gap-1 px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-700 text-white rounded-full hover:opacity-90 transition\">\r\n                    <i class=\"fas fa-user-plus\"></i> Đăng ký\r\n                </a>\r\n                {% endif %}\r\n\r\n                <a href=\"{% url 'eshop:cart' %}\" class=\"flex items-center gap-1 font-semibold bg-gray-100 hover:bg-blue-600 hover:text-white px-4 py-2 rounded-full transition relative\">\r\n                    <i class=\"fas fa-shopping-cart\"></i> Giỏ hàng\r\n                    {% if request.session.cart %}\r\n                    <span class=\"absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full\">{{ request.session.cart|length }}</span>\r\n                    {% endif %}\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </header>\r\n\r\n    {% block content %}{% endblock %}\r\n\r\n</body>\r\n</html>"
